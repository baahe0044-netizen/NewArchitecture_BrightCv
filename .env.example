APP_NAME=BrightCV
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/NewArchitecture_BrightCv/public
APP_KEY=replace-with-a-long-random-production-secret

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brightcv_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=lunettistar_session
SESSION_LIFETIME=7200
AI_PROVIDER=local
# Mail. `log` writes to storage/logs/mail.log and sends nothing, which is what
# you want locally. In production use `api`: free and shared hosts disable
# mail() and block the SMTP ports, but port 443 is always open.
#   api  - provider HTTPS API. Works everywhere. Set MAIL_API_* below.
#   smtp - needs outbound 465/587, which free hosts usually block.
#   mail - needs a local mail server on the host.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=BrightCV

# For MAIL_DRIVER=api. Provider is `brevo` or `resend`; both have free tiers.
# The from address has to be on a domain you verified with the provider.
MAIL_API_PROVIDER=brevo
MAIL_API_KEY=

# For MAIL_DRIVER=smtp only.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
