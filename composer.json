{
  "name": "brightcv/cv-builder",
  "description": "Production-ready CV builder with ATS guidance and smart writing tools.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "classmap": [
      "app/Core",
      "app/Controllers",
      "app/Services",
      "app/Repositories",
      "app/Middleware",
      "app/Helpers"
    ]
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
